#!/usr/bin/env python3
# Copyright (c) 2026 The claudecron authors
#
# claudecron - schedule and run autonomous agent loops on a fixed cadence.
#
# A single-file, standard-library-only Python 3 program. It wakes on a timer
# (launchd / systemd-user / cron), reads a small JSON registry of "loops", and
# for each loop that is enabled and due, runs an agent backend (Claude Code or
# Codex) with that loop's prompt, tools, and working directory.
#
# This replaces the earlier pure-bash implementation. The on-disk formats
# (registry.json, config.json, per-host state), the CLI surface, the scheduler
# unit label (dev.claudecron.runner) and its `run --wake` entrypoint, the
# backend invocation strings, and the runner.log line formats are all identical,
# so it is a drop-in replacement: existing loops, state files, and the installed
# timer keep working with no migration.
#
# Zero runtime dependencies beyond python3 itself (macOS and mainstream Linux
# both ship it). No jq, no third-party packages.

import argparse
import datetime
import json
import os
import re
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
import time
from pathlib import Path

VERSION_FALLBACK = "0.1.0"

# Loop-level defaults (single source of truth), matching the historical bash
# constants so registries written by either version are interchangeable.
DEFAULT_BACKEND = "claude"
DEFAULT_INTERVAL_MINUTES = 15
DEFAULT_ALLOWED_TOOLS = "Bash,Read"                  # library default
ADD_DEFAULT_ALLOWED_TOOLS = "Bash,Read,Write,Edit"   # the `add` command's default
DEFAULT_LOCK_STALE_MINUTES = 30
DEFAULT_LOG_KEEP_LINES = 500
# Model passed to the claude backend (--model). A loop's own `model` wins; then
# config `default_model`; then this constant. Empty string means "omit --model
# and let the claude CLI pick its own default". codex ignores the model.
DEFAULT_MODEL = "opus"

SCHED_LABEL = "dev.claudecron.runner"


# ---------------------------------------------------------------------------
# Small utilities
# ---------------------------------------------------------------------------

def now_iso():
    """Local timestamp like the bash `date '+%Y-%m-%dT%H:%M:%S%z'`."""
    return datetime.datetime.now().astimezone().strftime("%Y-%m-%dT%H:%M:%S%z")


def epoch_now():
    return int(time.time())


def log_stderr(msg):
    sys.stderr.write("%s [claudecron] %s\n" % (now_iso(), msg))


def die(msg, code=1):
    sys.stderr.write("%s [claudecron] ERROR: %s\n" % (now_iso(), msg))
    sys.exit(code)


def atomic_write(dest, text):
    """Write text to dest atomically (temp file in the same dir + rename)."""
    dest = Path(dest)
    dest.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=str(dest.parent), prefix=dest.name + ".tmp.")
    try:
        with os.fdopen(fd, "w") as fh:
            fh.write(text)
        os.replace(tmp, str(dest))
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def write_json(dest, obj):
    atomic_write(dest, json.dumps(obj, indent=2) + "\n")


def load_json(path, default):
    try:
        with open(path) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return default


def host_slug():
    try:
        name = socket.gethostname().split(".")[0]
    except OSError:
        name = ""
    if not name:
        name = "localhost"
    name = re.sub(r"[^A-Za-z0-9._-]", "-", name)
    return name or "localhost"


def parse_interval(raw):
    """Accept 15, 15m, 90min, 2h; return integer minutes. Reject sub-minute."""
    if raw is None:
        raise ValueError("empty interval")
    s = str(raw).strip()
    m = re.match(r"^([0-9]+)\s*([a-zA-Z]*)$", s)
    if not m:
        raise ValueError("invalid interval '%s' (expected forms: 90, 15m, 2h)" % raw)
    num = int(m.group(1))
    unit = m.group(2).lower()
    if unit in ("", "m", "min", "mins", "minute", "minutes"):
        minutes = num
    elif unit in ("h", "hr", "hrs", "hour", "hours"):
        minutes = num * 60
    elif unit in ("s", "sec", "secs", "second", "seconds"):
        raise ValueError("sub-minute intervals are not supported (got '%s')" % raw)
    else:
        raise ValueError("unknown interval unit in '%s' (use m or h)" % raw)
    if minutes < 1:
        raise ValueError("interval must be at least 1 minute (got '%s')" % raw)
    return minutes


def parse_at(raw):
    """Accept 'HH:MM' (24h, local time); return normalized 'HH:MM'."""
    m = re.match(r"^([01]?[0-9]|2[0-3]):([0-5][0-9])$", str(raw).strip())
    if not m:
        raise ValueError("invalid --at '%s' (expected HH:MM, 24h)" % raw)
    return "%02d:%02d" % (int(m.group(1)), int(m.group(2)))


def validate_id(loop_id):
    """CLI-level id validation: letters, digits, dot, dash, underscore."""
    if not loop_id or re.search(r"[^a-zA-Z0-9._-]", loop_id):
        die("invalid loop id '%s' (allowed: letters, digits, dot, dash, underscore)" % loop_id)


def iso_or_epoch_to_epoch(value):
    """Return an int epoch from an int/str epoch or ISO-8601 string, else None."""
    if value is None or value == "" or value == "null":
        return None
    if isinstance(value, (int, float)):
        return int(value)
    s = str(value).strip()
    if s.isdigit():
        return int(s)
    for fmt in ("%Y-%m-%dT%H:%M:%S%z", "%Y-%m-%dT%H:%M:%S", "%Y-%m-%d %H:%M:%S"):
        try:
            return int(datetime.datetime.strptime(s, fmt).timestamp())
        except ValueError:
            continue
    return None


# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------

class Paths:
    def __init__(self, home_override=None):
        self.home = self._resolve_home(home_override)
        self.prompts = self.home / "prompts"
        self.state = self.home / "state"
        self.logs = self.home / "logs"
        self.lock_dir = self.home / "lock"
        self.registry = self.home / "registry.json"
        self.config = self.home / "config.json"
        self.runner_log = self.logs / "runner.log"
        self.host = host_slug()

    @staticmethod
    def _resolve_home(override):
        if override:
            return Path(override)
        env = os.environ.get("CLAUDECRON_HOME")
        if env:
            return Path(env)
        xdg = os.environ.get("XDG_CONFIG_HOME")
        if xdg:
            return Path(xdg) / "claudecron"
        home = os.environ.get("HOME")
        if home:
            return Path(home) / ".config" / "claudecron"
        return Path(".") / ".claudecron"

    def state_dir(self):
        return self.state / self.host

    def state_path(self, loop_id):
        return self.state_dir() / ("%s.json" % loop_id)

    def loop_log(self, loop_id):
        return self.logs / ("%s.log" % loop_id)

    def mkdirs(self):
        for d in (self.home, self.prompts, self.state, self.state_dir(), self.logs):
            d.mkdir(parents=True, exist_ok=True)

    def runner_log_write(self, body):
        self.logs.mkdir(parents=True, exist_ok=True)
        try:
            with open(self.runner_log, "a") as fh:
                fh.write("%s %s\n" % (now_iso(), body))
        except OSError:
            pass


# ---------------------------------------------------------------------------
# Config
# ---------------------------------------------------------------------------

class Config:
    """config.json: 5 written defaults + optional read-only on_failure_cmd /
    run_timeout_s. The file wins over defaults; unknown keys are preserved."""

    DEFAULTS = {
        "backend": DEFAULT_BACKEND,
        "lock_stale_minutes": DEFAULT_LOCK_STALE_MINUTES,
        "log_keep_lines": DEFAULT_LOG_KEEP_LINES,
        "claude_bin": "",
        "codex_bin": "",
    }

    def __init__(self, paths):
        self.paths = paths

    def default_json(self):
        return dict(self.DEFAULTS)

    def ensure(self):
        self.paths.mkdirs()
        if not self.paths.config.exists():
            write_json(self.paths.config, self.default_json())
            log_stderr("created default config at %s" % self.paths.config)

    def read(self):
        merged = self.default_json()
        merged.update(load_json(self.paths.config, {}))
        return merged

    def get(self, key, default=None):
        val = self.read().get(key)
        if val is None or val == "":
            return default
        return val

    def set(self, key, value):
        self.ensure()
        data = self.read()
        data[key] = value
        write_json(self.paths.config, data)


# ---------------------------------------------------------------------------
# Registry
# ---------------------------------------------------------------------------

class Registry:
    def __init__(self, paths):
        self.paths = paths

    def ensure(self):
        self.paths.mkdirs()
        if not self.paths.registry.exists():
            write_json(self.paths.registry, {"loops": []})
            log_stderr("created empty registry at %s" % self.paths.registry)

    def read(self):
        data = load_json(self.paths.registry, {"loops": []})
        loops = data.get("loops")
        if not isinstance(loops, list):
            loops = []
        return {"loops": loops}

    def loops(self):
        return self.read()["loops"]

    def get(self, loop_id):
        for loop in self.loops():
            if loop.get("id") == loop_id:
                return loop
        return None

    def exists(self, loop_id):
        return self.get(loop_id) is not None

    def upsert(self, obj):
        loop_id = obj["id"]
        loops = [x for x in self.loops() if x.get("id") != loop_id]
        loops.append(obj)
        write_json(self.paths.registry, {"loops": loops})

    def remove(self, loop_id):
        loops = [x for x in self.loops() if x.get("id") != loop_id]
        write_json(self.paths.registry, {"loops": loops})


# ---------------------------------------------------------------------------
# State: per-host run state, read-merge-write so loop-owned keys survive
# ---------------------------------------------------------------------------

class State:
    def __init__(self, paths):
        self.paths = paths

    def get(self, loop_id):
        return load_json(self.paths.state_path(loop_id), {})

    def last_run_epoch(self, loop_id):
        return iso_or_epoch_to_epoch(self.get(loop_id).get("last_run"))

    def record_run(self, loop_id, status, duration_s):
        try:
            duration_s = int(duration_s)
        except (TypeError, ValueError):
            duration_s = 0
        data = self.get(loop_id)  # preserve loop-owned cursor keys
        data["last_run"] = epoch_now()
        data["last_status"] = status
        data["last_duration_s"] = duration_s
        write_json(self.paths.state_path(loop_id), data)


# ---------------------------------------------------------------------------
# Due-ness. Missed windows coalesce: last_run is stamped after each run, so any
# number of missed windows is exactly ONE catch-up run.
# ---------------------------------------------------------------------------

def is_due(last_run, interval_minutes):
    last = iso_or_epoch_to_epoch(last_run)
    if last is None:
        return True
    try:
        interval = int(interval_minutes)
    except (TypeError, ValueError):
        interval = 0
    delta = epoch_now() - last
    if delta < 0:
        return False
    return delta >= interval * 60


def is_due_at(last_run, at_hhmm):
    """Daily anchor: due once per day at or after HH:MM local time. A missed day
    coalesces into exactly one catch-up run, same contract as is_due."""
    try:
        hh, mm = str(at_hhmm).split(":")
        hh, mm = int(hh), int(mm)
    except (TypeError, ValueError):
        return False
    now = time.localtime()
    anchor = time.mktime((now.tm_year, now.tm_mon, now.tm_mday, hh, mm, 0, 0, 0, -1))
    if epoch_now() < anchor:
        return False
    last = iso_or_epoch_to_epoch(last_run)
    return last is None or last < anchor


# ---------------------------------------------------------------------------
# Lock: hold an OS advisory lock for the whole pass. A live holder is the
# kernel's own truth - no mtime/pid-age guessing, so a long-running loop is
# never trampled by the next wake.
# ---------------------------------------------------------------------------

class Lock:
    def __init__(self, paths):
        self.paths = paths
        self.lockfile = paths.lock_dir / "runner.lock"
        self._fh = None

    def acquire(self):
        import fcntl
        self.paths.lock_dir.mkdir(parents=True, exist_ok=True)
        self._fh = open(self.lockfile, "a+")
        try:
            fcntl.flock(self._fh.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            holder = self._read_holder()
            log_stderr("another runner%s holds the lock; skipping this run"
                       % ((" (pid %s)" % holder) if holder else ""))
            self._fh.close()
            self._fh = None
            return False
        self._fh.seek(0)
        self._fh.truncate()
        self._fh.write("%d\n" % os.getpid())
        self._fh.flush()
        log_stderr("acquired lock")
        return True

    def _read_holder(self):
        try:
            with open(self.lockfile) as fh:
                return fh.read().strip()
        except OSError:
            return ""

    def release(self):
        if self._fh is None:
            return
        import fcntl
        try:
            fcntl.flock(self._fh.fileno(), fcntl.LOCK_UN)
        except OSError:
            pass
        self._fh.close()
        self._fh = None
        log_stderr("released lock")


# ---------------------------------------------------------------------------
# Backend: resolve and invoke claude / codex, with the test seam
# ---------------------------------------------------------------------------

class Backend:
    def __init__(self, config):
        self.config = config

    def resolve_bin(self, backend):
        if backend == "claude":
            name, cfg_key = "claude", "claude_bin"
        elif backend == "codex":
            name, cfg_key = "codex", "codex_bin"
        elif backend == "exec":
            return "/bin/sh"
        else:
            die("unknown backend '%s' (expected: claude, codex, or exec)" % backend, code=127)
        pinned = self.config.get(cfg_key, "")
        if pinned and os.access(pinned, os.X_OK):
            return pinned
        found = shutil.which(name)
        if found:
            return found
        return self._login_shell_lookup(name)

    @staticmethod
    def _login_shell_lookup(name):
        shell = os.environ.get("SHELL", "/bin/bash")
        try:
            out = subprocess.run([shell, "-l", "-c", "command -v %s" % name],
                                 capture_output=True, text=True, timeout=15)
            path = out.stdout.strip().splitlines()[0] if out.stdout.strip() else ""
            if path and os.access(path, os.X_OK):
                return path
        except (OSError, subprocess.SubprocessError, IndexError):
            pass
        return None

    def build_argv(self, bin_path, backend, prompt, tools, cwd, add_dirs, model=""):
        if backend == "exec":
            # The "prompt" is a shell command line; tools and model do not apply.
            return [bin_path, "-c", prompt]
        if backend == "claude":
            argv = [bin_path, "-p", prompt, "--allowedTools", tools, "--add-dir", cwd]
            for d in add_dirs:
                if d:
                    argv += ["--add-dir", d]
            if model:
                argv += ["--model", model]
            argv += ["--output-format", "text"]
            return argv
        if backend == "codex":
            # codex selects its model via its own config, not a per-call flag.
            return [bin_path, "exec", prompt, "--cd", cwd,
                    "--sandbox", "workspace-write", "--ask-for-approval", "never"]
        die("cannot build argv for unknown backend '%s'" % backend, code=2)

    def preview(self, backend, bin_path, tools, cwd, add_dirs, model=""):
        if backend == "exec":
            return "%s -c '<command>'" % bin_path
        if backend == "claude":
            extra = "".join(" --add-dir '%s'" % d for d in add_dirs if d)
            model_s = (" --model '%s'" % model) if model else ""
            return ("%s -p '<prompt>' --allowedTools '%s' --add-dir '%s'%s%s "
                    "--output-format text" % (bin_path, tools, cwd, extra, model_s))
        if backend == "codex":
            return ("%s exec '<prompt>' --cd '%s' --sandbox workspace-write "
                    "--ask-for-approval never" % (bin_path, cwd))
        return "(unknown backend %s)" % backend

    def exec(self, backend, prompt, tools, cwd, add_dirs, log_fh, timeout_s, model=""):
        seam = os.environ.get("CLAUDECRON_TEST_BACKEND_CMD")
        if seam:
            return self._exec_seam(seam, backend, prompt, tools, cwd, log_fh, timeout_s)
        bin_path = self.resolve_bin(backend)
        if not bin_path:
            log_fh.write("backend '%s' binary not found on PATH\n" % backend)
            log_fh.flush()
            return 127
        argv = self.build_argv(bin_path, backend, prompt, tools, cwd, add_dirs, model)
        return self._run(argv, cwd, log_fh, timeout_s, env=None)

    def _exec_seam(self, seam, backend, prompt, tools, cwd, log_fh, timeout_s):
        env = dict(os.environ)
        env["CLAUDECRON_TEST_CWD"] = cwd
        env["CLAUDECRON_TEST_BACKEND"] = backend
        env["CLAUDECRON_TEST_TOOLS"] = tools
        argv = ["sh", "-c", seam, "--", prompt]  # prompt on stdin AND as $1
        return self._run(argv, cwd, log_fh, timeout_s, env=env, stdin_text=prompt)

    @staticmethod
    def _run(argv, cwd, log_fh, timeout_s, env=None, stdin_text=None):
        stdin = subprocess.PIPE if stdin_text is not None else subprocess.DEVNULL
        try:
            proc = subprocess.Popen(
                argv, cwd=cwd if os.path.isdir(cwd) else None,
                stdin=stdin, stdout=log_fh, stderr=subprocess.STDOUT,
                env=env, start_new_session=True,
            )
        except OSError as exc:
            log_fh.write("failed to start backend: %s\n" % exc)
            log_fh.flush()
            return 127
        try:
            # Popen is in bytes mode (stdout is a raw text file handle we opened),
            # so feed the prompt as encoded bytes.
            stdin_bytes = stdin_text.encode("utf-8") if stdin_text is not None else None
            proc.communicate(input=stdin_bytes,
                             timeout=(timeout_s if timeout_s and timeout_s > 0 else None))
            return proc.returncode
        except subprocess.TimeoutExpired:
            try:
                os.killpg(proc.pid, signal.SIGTERM)
            except OSError:
                pass
            try:
                proc.wait(timeout=2)
            except subprocess.TimeoutExpired:
                try:
                    os.killpg(proc.pid, signal.SIGKILL)
                except OSError:
                    pass
                proc.wait()
            return 124


# ---------------------------------------------------------------------------
# Runner
# ---------------------------------------------------------------------------

class Runner:
    def __init__(self, paths, config, registry, state, backend):
        self.paths = paths
        self.config = config
        self.registry = registry
        self.state = state
        self.backend = backend

    @staticmethod
    def field(loop, key, default):
        val = loop.get(key)
        return default if val is None else val

    def truncate_log(self, path, keep):
        try:
            keep = int(keep)
        except (TypeError, ValueError):
            keep = DEFAULT_LOG_KEEP_LINES
        if not path.exists():
            return
        try:
            with open(path) as fh:
                lines = fh.readlines()
            if len(lines) > keep:
                atomic_write(path, "".join(lines[-keep:]))
        except OSError:
            pass

    def notify_failure(self, loop_id, backend, rc, dur, loop_log):
        cmd = self.config.get("on_failure_cmd", "")
        if not cmd:
            return
        tail = ""
        try:
            with open(loop_log) as fh:
                tail = "".join(fh.readlines()[-20:])
        except OSError:
            pass
        self.paths.runner_log_write("notify id=%s firing on_failure_cmd" % loop_id)
        env = dict(os.environ)
        env.update({
            "CLAUDECRON_LOOP_ID": loop_id,
            "CLAUDECRON_BACKEND": backend,
            "CLAUDECRON_RESULT": "error",
            "CLAUDECRON_RC": str(rc),
            "CLAUDECRON_DURATION_S": str(dur),
            "CLAUDECRON_LOOP_LOG": str(loop_log),
            "CLAUDECRON_HOST": self.paths.host,
            "CLAUDECRON_LOG_TAIL": tail,
        })
        try:
            with open(self.paths.runner_log, "a") as rl:
                subprocess.run(["sh", "-c", cmd], stdin=subprocess.DEVNULL,
                               stdout=rl, stderr=subprocess.STDOUT, env=env)
        except (OSError, subprocess.SubprocessError):
            self.paths.runner_log_write(
                "notify id=%s on_failure_cmd exited non-zero (ignored)" % loop_id)

    def run_one(self, loop, force, dry_run, log_keep):
        loop_id = loop.get("id")
        # enabled defaults to True only when absent/None, NEVER treating the
        # boolean False as "use the default" (the historical jq `// true` bug).
        enabled = loop.get("enabled")
        enabled = True if enabled is None else bool(enabled)
        interval = self.field(loop, "interval_minutes", DEFAULT_INTERVAL_MINUTES)
        cwd = self.field(loop, "cwd", ".")
        tools = self.field(loop, "allowed_tools", DEFAULT_ALLOWED_TOOLS)
        prompt_file = loop.get("prompt_file") or ("prompts/%s.md" % loop_id)
        backend = self.field(loop, "backend", DEFAULT_BACKEND)
        add_dirs = loop.get("add_dirs") or []
        # Model resolution: the loop's own model wins; else the config default;
        # else the built-in DEFAULT_MODEL. An explicit empty string anywhere
        # means "omit --model and let the claude CLI choose".
        model = loop.get("model")
        if model is None:
            model = self.config.get("default_model", DEFAULT_MODEL)

        prompt_path = (Path(prompt_file) if os.path.isabs(prompt_file)
                       else self.paths.home / prompt_file)
        loop_log = self.paths.loop_log(loop_id)

        if not enabled and not force:
            self.paths.runner_log_write("skip id=%s reason=disabled" % loop_id)
            return

        last = self.state.last_run_epoch(loop_id)
        last_disp = "never" if last is None else str(last)
        at = loop.get("at") or ""
        sched_disp = ("at=%s" % at) if at else ("interval=%sm" % interval)
        if force:
            self.paths.runner_log_write("due id=%s forced=1" % loop_id)
        elif (is_due_at(last, at) if at else is_due(last, interval)):
            self.paths.runner_log_write(
                "due id=%s last=%s %s" % (loop_id, last_disp, sched_disp))
        else:
            self.paths.runner_log_write(
                "skip id=%s reason=not-due last=%s %s"
                % (loop_id, last_disp, sched_disp))
            return

        if dry_run:
            bin_preview = self.backend.resolve_bin(backend) or ("<%s-not-found>" % backend)
            sys.stderr.write("DRY-RUN loop=%s backend=%s cwd=%s prompt=%s\n"
                             % (loop_id, backend, cwd, prompt_path))
            sys.stderr.write("  command: %s\n"
                             % self.backend.preview(backend, bin_preview, tools, cwd, add_dirs, model))
            self.paths.runner_log_write(
                "dry-run id=%s backend=%s model=%s" % (loop_id, backend, model or "-"))
            return

        if not (prompt_path.is_file() and os.access(prompt_path, os.R_OK)):
            self.paths.runner_log_write(
                "status id=%s result=error reason=prompt-missing path=%s"
                % (loop_id, prompt_path))
            self.state.record_run(loop_id, "error", 0)
            return
        prompt = prompt_path.read_text()

        self.paths.runner_log_write(
            "run id=%s backend=%s model=%s cwd=%s" % (loop_id, backend, model or "-", cwd))

        timeout_s = os.environ.get("CLAUDECRON_RUN_TIMEOUT_S")
        if timeout_s is None or timeout_s == "":
            timeout_s = self.config.get("run_timeout_s", 0)
        try:
            timeout_s = int(timeout_s)
        except (TypeError, ValueError):
            timeout_s = 0

        start = epoch_now()
        self.paths.logs.mkdir(parents=True, exist_ok=True)
        with open(loop_log, "a") as log_fh:
            log_fh.write("%s ----- run start id=%s backend=%s -----\n"
                         % (now_iso(), loop_id, backend))
            log_fh.flush()
            rc = self.backend.exec(backend, prompt, tools, cwd, add_dirs, log_fh, timeout_s, model)
            log_fh.write("%s ----- run end id=%s rc=%s dur=%ss -----\n"
                         % (now_iso(), loop_id, rc, epoch_now() - start))
            if rc == 124:
                log_fh.write("%s ----- run TIMED OUT id=%s after %ss -----\n"
                             % (now_iso(), loop_id, timeout_s))
        dur = max(0, epoch_now() - start)
        self.truncate_log(loop_log, log_keep)

        if rc == 124:
            self.paths.runner_log_write("timeout id=%s after=%ss" % (loop_id, timeout_s))

        if rc == 0:
            self.state.record_run(loop_id, "ok", dur)
            self.paths.runner_log_write("status id=%s result=ok dur=%ss" % (loop_id, dur))
        else:
            self.state.record_run(loop_id, "error", dur)
            self.paths.runner_log_write(
                "status id=%s result=error rc=%s dur=%ss" % (loop_id, rc, dur))
            self.notify_failure(loop_id, backend, rc, dur, loop_log)

    def run_pass(self, wake=False, dry_run=False, force=False, only_id=None):
        lock = None
        if not dry_run:
            lock = Lock(self.paths)
            if not lock.acquire():
                return 0
        try:
            self.paths.mkdirs()
            self.registry.ensure()
            self.config.ensure()
            log_keep = self.config.get("log_keep_lines", DEFAULT_LOG_KEEP_LINES)
            self.paths.runner_log_write(
                "wake source=%s host=%s" % ("scheduler" if wake else "cli", self.paths.host))
            # Materialize the loop list up front; nothing a backend does to its
            # own stdin can affect our iteration (the historical starvation bug).
            loops = list(self.registry.loops())
            count = 0
            for loop in loops:
                if only_id is not None and loop.get("id") != only_id:
                    continue
                count += 1
                self.run_one(loop, force, dry_run, log_keep)
            if only_id is not None and count == 0:
                die("no loop with id '%s' in registry" % only_id)
            self.paths.runner_log_write(
                "wake done host=%s processed=%d" % (self.paths.host, count))
            return 0
        finally:
            if lock is not None:
                lock.release()


# ---------------------------------------------------------------------------
# Scheduler
# ---------------------------------------------------------------------------

class Scheduler:
    def __init__(self, paths, self_bin):
        self.paths = paths
        self.self_bin = self_bin
        home = os.environ.get("HOME", "")
        self.launchd_plist = Path(home) / "Library" / "LaunchAgents" / ("%s.plist" % SCHED_LABEL)
        xdg = os.environ.get("XDG_CONFIG_HOME") or (home + "/.config")
        self.systemd_dir = Path(xdg) / "systemd" / "user"
        self.systemd_service = self.systemd_dir / ("%s.service" % SCHED_LABEL)
        self.systemd_timer = self.systemd_dir / ("%s.timer" % SCHED_LABEL)
        self.cron_begin = "# >>> %s >>>" % SCHED_LABEL
        self.cron_end = "# <<< %s <<<" % SCHED_LABEL
        try:
            self.tick_minutes = max(1, int(os.environ.get("CLAUDECRON_TICK_MINUTES", "1")))
        except ValueError:
            self.tick_minutes = 1

    def detect(self):
        try:
            osname = subprocess.run(["uname", "-s"], capture_output=True, text=True).stdout.strip()
        except (OSError, subprocess.SubprocessError):
            osname = ""
        if osname == "Darwin":
            return "launchd"
        if osname == "Linux" and shutil.which("systemctl"):
            if subprocess.run(["systemctl", "--user", "show-environment"],
                              capture_output=True).returncode == 0:
                return "systemd"
        if shutil.which("crontab"):
            return "cron"
        return "none"

    def resolve_path(self):
        login = ""
        shell = os.environ.get("SHELL", "/bin/bash")
        try:
            login = subprocess.run([shell, "-l", "-c", 'printf %s "$PATH"'],
                                   capture_output=True, text=True, timeout=15).stdout
        except (OSError, subprocess.SubprocessError):
            login = ""
        home = os.environ.get("HOME", "")
        known = "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:%s/.local/bin" % home
        out = []
        for seg in ("%s:%s" % (login, known)).split(":"):
            if seg and seg not in out:
                out.append(seg)
        return ":".join(out)

    def tick_seconds(self):
        return max(1, self.tick_minutes * 60)

    def launchd_plist_body(self):
        return (
            '<?xml version="1.0" encoding="UTF-8"?>\n'
            '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" '
            '"http://www.apple.com/DTDs/PropertyList-1.0.dtd">\n'
            '<plist version="1.0">\n<dict>\n'
            '  <key>Label</key>\n  <string>%s</string>\n'
            '  <key>ProgramArguments</key>\n  <array>\n'
            '    <string>%s</string>\n    <string>run</string>\n    <string>--wake</string>\n'
            '  </array>\n'
            '  <key>EnvironmentVariables</key>\n  <dict>\n'
            '    <key>PATH</key>\n    <string>%s</string>\n'
            '    <key>CLAUDECRON_HOME</key>\n    <string>%s</string>\n  </dict>\n'
            '  <key>StartInterval</key>\n  <integer>%d</integer>\n'
            '  <key>RunAtLoad</key>\n  <true/>\n'
            '  <key>ProcessType</key>\n  <string>Background</string>\n'
            '  <key>LowPriorityIO</key>\n  <true/>\n'
            '  <key>StandardOutPath</key>\n  <string>%s</string>\n'
            '  <key>StandardErrorPath</key>\n  <string>%s</string>\n'
            '</dict>\n</plist>\n'
            % (SCHED_LABEL, self.self_bin, self.resolve_path(), self.paths.home,
               self.tick_seconds(), self.paths.runner_log, self.paths.runner_log)
        )

    def systemd_service_body(self):
        return (
            "[Unit]\nDescription=claudecron runner (%s)\n\n"
            "[Service]\nType=oneshot\nEnvironment=PATH=%s\n"
            "Environment=CLAUDECRON_HOME=%s\nExecStart=%s run --wake\n"
            % (SCHED_LABEL, self.resolve_path(), self.paths.home, self.self_bin)
        )

    def systemd_timer_body(self):
        return (
            "[Unit]\nDescription=claudecron runner timer (%s)\n\n"
            "[Timer]\nOnBootSec=%d\nOnUnitActiveSec=%d\nAccuracySec=15\n"
            "Persistent=true\n\n[Install]\nWantedBy=timers.target\n"
            % (SCHED_LABEL, self.tick_seconds(), self.tick_seconds())
        )

    def install(self, which=None):
        which = which or self.detect()
        self.paths.mkdirs()
        if which == "launchd":
            self._install_launchd()
        elif which == "systemd":
            self._install_systemd()
        elif which == "cron":
            self._install_cron()
        elif which == "none":
            die("no supported scheduler found (launchd/systemd/cron all unavailable).", code=1)
        else:
            die("unknown scheduler '%s'" % which, code=2)
        if self.verify(which):
            log_stderr("scheduler '%s' installed and verified" % which)
        else:
            log_stderr("scheduler '%s' installed but not confirmed; check logs" % which)

    @staticmethod
    def _run(argv):
        try:
            return subprocess.run(argv, capture_output=True).returncode
        except (OSError, subprocess.SubprocessError):
            return 1

    def _install_launchd(self):
        self.launchd_plist.parent.mkdir(parents=True, exist_ok=True)
        atomic_write(self.launchd_plist, self.launchd_plist_body())
        domain = "gui/%d" % os.getuid()
        target = "%s/%s" % (domain, SCHED_LABEL)
        self._run(["launchctl", "bootout", target])
        if self._run(["launchctl", "bootstrap", domain, str(self.launchd_plist)]) == 0:
            log_stderr("launchd: bootstrapped %s" % SCHED_LABEL)
        else:
            self._run(["launchctl", "unload", str(self.launchd_plist)])
            self._run(["launchctl", "load", str(self.launchd_plist)])
            log_stderr("launchd: loaded %s (legacy load path)" % SCHED_LABEL)
        self._run(["launchctl", "enable", target])
        self._run(["launchctl", "kickstart", "-k", target])

    def _uninstall_launchd(self):
        target = "gui/%d/%s" % (os.getuid(), SCHED_LABEL)
        self._run(["launchctl", "bootout", target])
        self._run(["launchctl", "unload", str(self.launchd_plist)])
        try:
            self.launchd_plist.unlink()
        except OSError:
            pass
        log_stderr("launchd: removed %s" % SCHED_LABEL)

    def _verify_launchd(self):
        if self._run(["launchctl", "print", "gui/%d/%s" % (os.getuid(), SCHED_LABEL)]) == 0:
            return True
        try:
            out = subprocess.run(["launchctl", "list"], capture_output=True, text=True).stdout
            return SCHED_LABEL in out
        except (OSError, subprocess.SubprocessError):
            return False

    def _install_systemd(self):
        self.systemd_dir.mkdir(parents=True, exist_ok=True)
        atomic_write(self.systemd_service, self.systemd_service_body())
        atomic_write(self.systemd_timer, self.systemd_timer_body())
        self._run(["systemctl", "--user", "daemon-reload"])
        self._run(["systemctl", "--user", "enable", "--now", "%s.timer" % SCHED_LABEL])
        self._run(["loginctl", "enable-linger", self._username()])
        log_stderr("systemd: enabled %s.timer" % SCHED_LABEL)

    def _uninstall_systemd(self):
        self._run(["systemctl", "--user", "disable", "--now", "%s.timer" % SCHED_LABEL])
        self._run(["systemctl", "--user", "stop", "%s.service" % SCHED_LABEL])
        for p in (self.systemd_timer, self.systemd_service):
            try:
                p.unlink()
            except OSError:
                pass
        self._run(["systemctl", "--user", "daemon-reload"])
        log_stderr("systemd: removed %s units" % SCHED_LABEL)

    def _verify_systemd(self):
        try:
            out = subprocess.run(["systemctl", "--user", "list-timers", "--all"],
                                 capture_output=True, text=True).stdout
            if ("%s.timer" % SCHED_LABEL) in out:
                return True
        except (OSError, subprocess.SubprocessError):
            pass
        return self._run(["systemctl", "--user", "is-enabled", "%s.timer" % SCHED_LABEL]) == 0

    @staticmethod
    def _username():
        try:
            import getpass
            return getpass.getuser()
        except Exception:
            return os.environ.get("USER", "")

    def _cron_block(self):
        return "\n".join([
            self.cron_begin,
            "PATH=%s" % self.resolve_path(),
            "CLAUDECRON_HOME=%s" % self.paths.home,
            "*/%d * * * * %s run --wake >> %s 2>&1"
            % (self.tick_minutes, self.self_bin, self.paths.runner_log),
            self.cron_end,
            "",
        ])

    def _current_crontab_without_block(self):
        try:
            out = subprocess.run(["crontab", "-l"], capture_output=True, text=True).stdout
        except (OSError, subprocess.SubprocessError):
            out = ""
        lines, skip = [], False
        for line in out.splitlines():
            if line == self.cron_begin:
                skip = True
                continue
            if line == self.cron_end:
                skip = False
                continue
            if not skip:
                lines.append(line)
        return lines

    def _install_cron(self):
        content = "\n".join(self._current_crontab_without_block()) + "\n" + self._cron_block()
        self._crontab_replace(content)
        log_stderr("cron: installed managed block for %s" % SCHED_LABEL)

    def _uninstall_cron(self):
        content = "\n".join(self._current_crontab_without_block()) + "\n"
        self._crontab_replace(content)
        log_stderr("cron: removed managed block for %s" % SCHED_LABEL)

    def _crontab_replace(self, content):
        try:
            p = subprocess.Popen(["crontab", "-"], stdin=subprocess.PIPE, text=True)
            p.communicate(content)
        except (OSError, subprocess.SubprocessError):
            log_stderr("cron: failed to install crontab")

    def _verify_cron(self):
        try:
            out = subprocess.run(["crontab", "-l"], capture_output=True, text=True).stdout
            return SCHED_LABEL in out
        except (OSError, subprocess.SubprocessError):
            return False

    def verify(self, which=None):
        which = which or self.detect()
        return {"launchd": self._verify_launchd, "systemd": self._verify_systemd,
                "cron": self._verify_cron}.get(which, lambda: False)()

    def uninstall(self):
        if shutil.which("launchctl"):
            self._uninstall_launchd()
        else:
            try:
                self.launchd_plist.unlink()
            except OSError:
                pass
        if shutil.which("systemctl"):
            self._uninstall_systemd()
        else:
            for p in (self.systemd_timer, self.systemd_service):
                try:
                    p.unlink()
                except OSError:
                    pass
        if shutil.which("crontab"):
            self._uninstall_cron()
        log_stderr("uninstalled scheduler from all backends")

    def init_config(self, config):
        for name, key in (("claude", "claude_bin"), ("codex", "codex_bin")):
            found = shutil.which(name)
            if found:
                config.set(key, found)

    def last_wake(self):
        if self.paths.runner_log.exists():
            try:
                lines = self.paths.runner_log.read_text().splitlines()
                return lines[-1] if lines else ""
            except OSError:
                return ""
        return ""


# ---------------------------------------------------------------------------
# Skills
# ---------------------------------------------------------------------------

class Skills:
    def __init__(self, libexec):
        self.src = Path(libexec) / "skills"
        home = os.environ.get("HOME", "")
        self.claude_dir = Path(os.environ.get("CLAUDECRON_CLAUDE_SKILLS_DIR",
                                              home + "/.claude/skills"))
        self.codex_dir = Path(os.environ.get("CLAUDECRON_CODEX_PROMPTS_DIR",
                                             home + "/.codex/prompts"))

    def install(self):
        home = Path(os.environ.get("HOME", ""))
        if (home / ".claude").exists():
            for name in ("claudecron", "claudecron-status"):
                s = self.src / name
                if s.is_dir():
                    d = self.claude_dir / name
                    if d.exists():
                        shutil.rmtree(d, ignore_errors=True)
                    self.claude_dir.mkdir(parents=True, exist_ok=True)
                    shutil.copytree(s, d)
                    log_stderr("skills: installed %s -> %s" % (name, d))
        codex_src = self.src / "codex-claudecron" / "AGENTS.md"
        if (home / ".codex").exists() and codex_src.is_file():
            self.codex_dir.mkdir(parents=True, exist_ok=True)
            shutil.copy(codex_src, self.codex_dir / "claudecron.md")
            log_stderr("skills: installed codex prompt -> %s" % (self.codex_dir / "claudecron.md"))

    def remove(self):
        for name in ("claudecron", "claudecron-status"):
            shutil.rmtree(self.claude_dir / name, ignore_errors=True)
        try:
            (self.codex_dir / "claudecron.md").unlink()
        except OSError:
            pass
        log_stderr("skills: removed")

    def status(self):
        print("claude skills dir: %s" % self.claude_dir)
        print("codex prompts dir: %s" % self.codex_dir)


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

def libexec_root():
    # bin/claudecron lives in <libexec>/bin/, so libexec is the parent's parent.
    return Path(__file__).resolve().parent.parent


def read_version():
    try:
        return (libexec_root() / "VERSION").read_text().strip() or VERSION_FALLBACK
    except OSError:
        return VERSION_FALLBACK


def human_next_due(state, loop_id, interval):
    last = state.last_run_epoch(loop_id)
    if last is None:
        return "now"
    due = last + int(interval) * 60
    now = epoch_now()
    if now >= due:
        return "now"
    return "in %dm" % ((due - now + 59) // 60)


SELF_IMPROVE_ID = "self-improve"
SELF_IMPROVE_INTERVAL_MINUTES = 2880  # every 2 days


def seed_self_improve(paths, registry):
    """Register the built-in self-improve loop if it is not already present.

    Idempotent: an existing entry (however the user has configured it) is left
    untouched. The loop is seeded DISABLED - a self-editing agent is opt-in, not
    something a fresh install should start running unprompted. The user enables
    it with `claudecron enable self-improve`, or runs a one-off pass any time
    with `claudecron improve`. The shipped builtin prompt is copied into the
    data dir so upgrades can refresh it.
    """
    if registry.exists(SELF_IMPROVE_ID):
        log_stderr("self-improve loop already present; leaving as is")
        return
    src = libexec_root() / "builtins" / "self-improve.prompt.md"
    if not src.exists():
        log_stderr("builtin self-improve prompt not found at %s; skipping seed" % src)
        return
    prompt_rel = "prompts/%s.md" % SELF_IMPROVE_ID
    paths.prompts.mkdir(parents=True, exist_ok=True)
    atomic_write(paths.home / prompt_rel, src.read_text())
    registry.upsert({
        "id": SELF_IMPROVE_ID,
        "enabled": False,
        "interval_minutes": SELF_IMPROVE_INTERVAL_MINUTES,
        "cwd": os.environ.get("HOME", "/"),
        "add_dirs": [],
        "allowed_tools": "Bash,Read,Write",
        "prompt_file": prompt_rel,
        "backend": "claude",
    })
    log_stderr("seeded built-in self-improve loop (disabled; enable with "
               "'claudecron enable %s')" % SELF_IMPROVE_ID)


def cmd_init(args, ctx):
    paths, config, registry = ctx["paths"], ctx["config"], ctx["registry"]
    paths.mkdirs()
    log_stderr("data home: %s" % paths.home)
    config.ensure()
    if args.backend:
        if args.backend not in ("claude", "codex"):
            die("init: --backend must be 'claude' or 'codex' (got '%s')" % args.backend)
        config.set("backend", args.backend)
        log_stderr("backend set to %s" % args.backend)
    # Wire the default failure notifier (claudecron-notify, shipped alongside
    # this binary) unless the user has already set their own on_failure_cmd. It
    # fires a local, backend-independent alert on any loop failure, so an outage
    # that fails every loop - including an agent-quota exhaustion - is never
    # fully silent. Only set it if the helper is actually present next to us.
    if not config.get("on_failure_cmd", ""):
        helper = Path(__file__).resolve().parent / "claudecron-notify"
        if helper.exists():
            config.set("on_failure_cmd", str(helper))
            log_stderr("wired default failure notifier: %s" % helper)
    registry.ensure()
    seed_self_improve(paths, registry)
    if args.no_scheduler or os.environ.get("CLAUDECRON_INIT_SCHEDULER") == "0":
        log_stderr("skipping scheduler install")
    else:
        sched = ctx["scheduler"]()
        which = sched.detect()
        log_stderr("detected scheduler: %s" % which)
        if which == "none":
            log_stderr("no supported scheduler found; run loops manually with 'claudecron run'")
        else:
            sched.init_config(config)
            sched.install(which)
    if args.no_skills:
        log_stderr("skipping skills install")
    else:
        ctx["skills"]().install()
    log_stderr("init complete. add a loop with: claudecron add <id>")


def cmd_add(args, ctx):
    paths, config, registry = ctx["paths"], ctx["config"], ctx["registry"]
    loop_id = args.id
    validate_id(loop_id)
    if registry.exists(loop_id) and not args.force:
        die("loop '%s' already exists; pass --force to overwrite" % loop_id)
    sources = sum(1 for x in (args.prompt, args.prompt_file, args.stdin) if x)
    scripted = any([args.interval, args.at is not None, args.cwd, args.tools, args.backend,
                    args.prompt, args.prompt_file, args.stdin, args.add_dir, args.enabled,
                    args.disabled])
    if not scripted:
        die("add: interactive mode needs a TTY; pass --interval/--cwd/--tools/--prompt(-file)")
    if sources > 1:
        die("add: choose only one of --prompt, --prompt-file, or - (stdin)")

    # Re-add preserves fields the caller did not restate. When overwriting an
    # existing loop (--force) each field falls back to the existing value, not
    # the global default, so a prompt-only re-add keeps interval/cwd/tools/etc.
    # This is what makes `claudecron add <id> --prompt-file X` a safe in-place
    # prompt update - the path the self-improve loop uses to rewrite prompts.
    existing = registry.get(loop_id) or {}

    if args.interval:
        interval = parse_interval(args.interval)
    elif existing:
        interval = parse_interval(existing.get("interval_minutes", DEFAULT_INTERVAL_MINUTES))
    else:
        interval = parse_interval(DEFAULT_INTERVAL_MINUTES)

    # Daily anchor: --at HH:MM wins over interval at run time; --at "" clears it.
    if args.at is not None:
        at = parse_at(args.at) if args.at else ""
    else:
        at = existing.get("at", "") if existing else ""

    if args.cwd:
        cwd = args.cwd
    elif existing.get("cwd"):
        cwd = existing["cwd"]
    else:
        cwd = os.getcwd()
        log_stderr("no --cwd given; defaulting to %s" % cwd)
    if not cwd.startswith("/"):
        die("add: --cwd must be an absolute path (got '%s')" % cwd)

    if args.add_dir:
        add_dirs = args.add_dir
    else:
        add_dirs = existing.get("add_dirs", []) if existing else []
    for d in add_dirs:
        if not d.startswith("/"):
            die("add: --add-dir must be absolute (got '%s')" % d)

    tools = args.tools or existing.get("allowed_tools") or ADD_DEFAULT_ALLOWED_TOOLS
    backend = args.backend or existing.get("backend") or config.get("backend", "claude")
    if backend not in ("claude", "codex", "exec"):
        die("add: backend must be 'claude', 'codex', or 'exec' (got '%s')" % backend)
    if args.prompt:
        prompt_content = args.prompt
    elif args.prompt_file:
        if not os.path.isfile(args.prompt_file):
            die("add: prompt file not found: %s" % args.prompt_file)
        prompt_content = Path(args.prompt_file).read_text()
    elif args.stdin:
        prompt_content = sys.stdin.read()
    else:
        die("add: empty prompt; provide --prompt, --prompt-file, or - (stdin)")
    if not prompt_content:
        die("add: empty prompt; provide --prompt, --prompt-file, or - (stdin)")
    prompt_rel = "prompts/%s.md" % loop_id
    paths.prompts.mkdir(parents=True, exist_ok=True)
    atomic_write(paths.home / prompt_rel,
                 prompt_content if prompt_content.endswith("\n") else prompt_content + "\n")
    log_stderr("wrote prompt: %s" % (paths.home / prompt_rel))
    # enabled: explicit flags win; otherwise preserve the existing value on
    # re-add, and default to enabled for a brand-new loop.
    if args.enabled:
        enabled = True
    elif args.disabled:
        enabled = False
    elif existing:
        enabled = bool(existing.get("enabled", True))
    else:
        enabled = True
    entry = {
        "id": loop_id,
        "enabled": enabled,
        "interval_minutes": interval,
        "cwd": cwd,
        "add_dirs": add_dirs,
        "allowed_tools": tools,
        "prompt_file": prompt_rel,
        "backend": backend,
    }
    if at:
        entry["at"] = at
    # Only pin a per-loop model when one is given; otherwise the loop follows
    # config default_model. An explicit --model "" means "omit --model" (CLI
    # default) and is stored as such to override the config default. On re-add
    # without --model, preserve any existing per-loop model pin.
    if args.model is not None:
        entry["model"] = args.model
    elif existing and "model" in existing:
        entry["model"] = existing["model"]
    registry.upsert(entry)
    sched_desc = ("at %s daily" % at) if at else ("interval %dm" % interval)
    log_stderr("added loop '%s' (%s, backend %s, model %s, enabled=%s)"
               % (loop_id, sched_desc, backend, args.model if args.model is not None else "default",
                  str(enabled).lower()))
    log_stderr("it will NOT run until the scheduler fires; test now with: claudecron run --now %s"
               % loop_id)


def cmd_list(args, ctx):
    ids = [x.get("id") for x in ctx["registry"].loops()]
    if args.json or ctx["json"]:
        print(json.dumps(ids))
        return
    if not ids:
        log_stderr("no loops yet; add one with: claudecron add <id>")
        return
    for i in ids:
        print(i)


def cmd_status(args, ctx):
    registry, state = ctx["registry"], ctx["state"]
    loops = registry.loops()
    if args.json or ctx["json"]:
        out = []
        for loop in loops:
            st = state.get(loop.get("id"))
            out.append({
                "id": loop.get("id"),
                "enabled": loop.get("enabled"),
                "interval_minutes": loop.get("interval_minutes"),
                "backend": loop.get("backend"),
                "last_run": st.get("last_run") or "",
                "last_status": st.get("last_status") or "",
            })
        print(json.dumps(out))
        return
    if not loops:
        log_stderr("no loops registered")
        return
    hdr = "%-20s %-8s %-9s %-8s %-20s %-9s %s"
    print(hdr % ("ID", "ENABLED", "INTERVAL", "BACKEND", "LAST_RUN", "STATUS", "NEXT_DUE"))
    print(hdr % ("-" * 20, "-" * 8, "-" * 9, "-" * 8, "-" * 20, "-" * 9, "-" * 8))
    for loop in loops:
        lid = loop.get("id")
        st = state.get(lid)
        interval = loop.get("interval_minutes", DEFAULT_INTERVAL_MINUTES)
        last_run = st.get("last_run")
        last_run = str(last_run) if last_run not in (None, "") else "-"
        last_status = st.get("last_status") or "-"
        print(hdr % (lid, str(loop.get("enabled")).lower(), "%sm" % interval,
                     loop.get("backend"), last_run, last_status,
                     human_next_due(state, lid, interval)))


def cmd_run(args, ctx):
    runner = ctx["runner"]
    if args.now:
        validate_id(args.now)
        if not ctx["registry"].exists(args.now):
            die("run: no such loop '%s'" % args.now)
        log_stderr("forcing run of '%s' (ignoring due/enabled)" % args.now)
        return runner.run_pass(force=True, only_id=args.now, dry_run=args.dry_run)
    log_stderr("starting due pass on %s" % ctx["paths"].host)
    return runner.run_pass(wake=True, dry_run=args.dry_run)


def cmd_improve(args, ctx):
    """Run one self-improve pass now: audit loop prompts and improve them.

    Same pass the scheduled self-improve loop runs, on demand. With --id, focus
    the audit on a single loop (exported as CLAUDECRON_IMPROVE_FOCUS, which the
    self-improve prompt reads). The self-improve loop is forced to run here even
    if it is disabled - running it explicitly is the opt-in.
    """
    registry, runner = ctx["registry"], ctx["runner"]
    if not registry.exists(SELF_IMPROVE_ID):
        die("no self-improve loop; run 'claudecron init' to seed it")
    if args.id:
        validate_id(args.id)
        if not registry.exists(args.id):
            die("improve: no such loop '%s'" % args.id)
        log_stderr("improve focus: %s" % args.id)
        os.environ["CLAUDECRON_IMPROVE_FOCUS"] = args.id
    return runner.run_pass(force=True, only_id=SELF_IMPROVE_ID, dry_run=args.dry_run)


def cmd_logs(args, ctx):
    paths = ctx["paths"]
    lines = args.lines if args.lines else 200
    if args.runner:
        target = paths.runner_log
    else:
        if not args.id:
            die("logs: missing <id> (or pass --runner for the runner log)")
        validate_id(args.id)
        target = paths.loop_log(args.id)
    if not target.exists():
        log_stderr("no log yet at %s" % target)
        return
    argv = ["tail", "-n", str(lines)] + (["-f"] if args.follow else []) + [str(target)]
    os.execvp("tail", argv)


def cmd_enable(args, ctx):
    _toggle(True, args, ctx)


def cmd_disable(args, ctx):
    _toggle(False, args, ctx)


def _toggle(want, args, ctx):
    verb = "enable" if want else "disable"
    if args.scheduler:
        sched = ctx["scheduler"]()
        if want:
            sched.install()
            log_stderr("scheduler enabled")
        else:
            sched.uninstall()
            log_stderr("scheduler disabled (loops will not fire until re-enabled)")
        return
    if not args.id:
        die("%s: missing <id> (or pass --scheduler)" % verb)
    validate_id(args.id)
    registry = ctx["registry"]
    loop = registry.get(args.id)
    if loop is None:
        die("%s: no such loop '%s'" % (verb, args.id))
    loop["enabled"] = want
    registry.upsert(loop)
    log_stderr("loop '%s' %sd" % (args.id, verb))


def cmd_remove(args, ctx):
    paths, registry = ctx["paths"], ctx["registry"]
    if not args.id:
        die("remove: missing <id>")
    validate_id(args.id)
    if not registry.exists(args.id):
        die("remove: no such loop '%s'" % args.id)
    if not args.yes:
        suffix = " and PURGE its prompt+state" if args.purge else ""
        sys.stderr.write('Remove loop "%s"%s? [y/N]: ' % (args.id, suffix))
        try:
            ans = sys.stdin.readline().strip()
        except (OSError, KeyboardInterrupt):
            ans = ""
        if ans not in ("y", "Y", "yes", "YES"):
            log_stderr("aborted")
            return
    registry.remove(args.id)
    log_stderr("removed registry entry '%s'" % args.id)
    if args.purge:
        pf = paths.home / ("prompts/%s.md" % args.id)
        if pf.exists():
            pf.unlink()
            log_stderr("purged %s" % pf)
        if paths.state.exists():
            for sd in paths.state.iterdir():
                sfile = sd / ("%s.json" % args.id)
                if sfile.exists():
                    sfile.unlink()
                    log_stderr("purged %s" % sfile)


def cmd_doctor(args, ctx):
    paths, config = ctx["paths"], ctx["config"]
    fails = [0]

    def ok(m):
        print("  [ OK ] %s" % m)

    def warn(m):
        print("  [WARN] %s" % m)

    def fail(m):
        print("  [FAIL] %s" % m)
        fails[0] += 1

    print("claudecron doctor (%s)" % read_version())
    print("home: %s" % paths.home)
    print("libexec: %s\n" % libexec_root())
    print("environment:")
    ok("python %d.%d.%d" % sys.version_info[:3])
    backend = ctx["backend"]
    cfg_backend = config.get("backend", "claude")
    print("\nbackends:")
    print("  configured backend: %s" % cfg_backend)
    for name in ("claude", "codex"):
        b = backend.resolve_bin(name)
        if b:
            ok("%s -> %s" % (name, b))
        elif cfg_backend == name:
            fail("%s backend not resolved; set %s_bin in config.json or add it to PATH"
                 % (name, name))
        else:
            warn("%s backend not resolved (not the active backend)" % name)
    print("\nregistry:")
    if not paths.registry.exists():
        warn("no registry yet at %s; run 'claudecron init'" % paths.registry)
    else:
        ok("registry valid (%d loop(s))" % len(ctx["registry"].loops()))
    print("\nconfig:")
    ok("config valid" if paths.config.exists() else "no config yet; run 'claudecron init'")
    print("\nscheduler:")
    sched = ctx["scheduler"]()
    which = sched.detect()
    print("  type: %s" % which)
    if sched.verify(which):
        ok("scheduler unit loaded (%s)" % SCHED_LABEL)
        lw = sched.last_wake()
        if lw:
            print("  last wake: %s" % lw)
    else:
        warn("scheduler not loaded; install with 'claudecron scheduler install'")
    print("")
    if fails[0]:
        print("doctor: %d check(s) FAILED." % fails[0])
        sys.exit(1)
    print("doctor: all critical checks passed.")


def cmd_scheduler(args, ctx):
    sched = ctx["scheduler"]()
    if args.action == "install":
        sched.install()
    elif args.action == "remove":
        sched.uninstall()
    elif args.action == "status":
        which = sched.detect()
        print("scheduler: %s" % which)
        print("loaded: %s" % ("yes" if sched.verify(which) else "no"))
    else:
        die("scheduler: unknown action '%s' (install|remove|status)" % args.action)


def cmd_skills(args, ctx):
    skills = ctx["skills"]()
    action = args.action or "status"
    if action == "install":
        skills.install()
    elif action == "remove":
        skills.remove()
    elif action == "status":
        skills.status()
    else:
        die("skills: unknown action '%s' (install|remove|status)" % action)


def cmd_uninstall(args, ctx):
    ctx["scheduler"]().uninstall()
    ctx["skills"]().remove()
    if args.purge:
        shutil.rmtree(ctx["paths"].home, ignore_errors=True)
        log_stderr("purged data home")


def cmd_version(args, ctx):
    if ctx["json"]:
        print(json.dumps({"name": "claudecron", "version": read_version(),
                          "libexec": str(libexec_root())}))
    else:
        print("claudecron %s" % read_version())


def build_parser():
    p = argparse.ArgumentParser(prog="claudecron",
                                description="run autonomous agent loops on a schedule")
    p.add_argument("--json", action="store_true")
    p.add_argument("--config", dest="config_dir")
    p.add_argument("-q", "--quiet", action="store_true")
    p.add_argument("-v", "--verbose", action="store_true")
    sub = p.add_subparsers(dest="command")

    pi = sub.add_parser("init")
    pi.add_argument("--backend")
    pi.add_argument("--no-scheduler", action="store_true")
    pi.add_argument("--no-skills", action="store_true")

    pa = sub.add_parser("add")
    pa.add_argument("id")
    pa.add_argument("--interval")
    pa.add_argument("--at")
    pa.add_argument("--cwd")
    pa.add_argument("--add-dir", action="append", dest="add_dir")
    pa.add_argument("--tools")
    pa.add_argument("--backend")
    pa.add_argument("--model")
    pa.add_argument("--prompt")
    pa.add_argument("--prompt-file")
    pa.add_argument("-", dest="stdin", action="store_true")
    pa.add_argument("--enabled", action="store_true")
    pa.add_argument("--disabled", action="store_true")
    pa.add_argument("--force", action="store_true")

    for name in ("list", "ls"):
        pl = sub.add_parser(name)
        pl.add_argument("--json", action="store_true")
    for name in ("status", "st"):
        ps = sub.add_parser(name)
        ps.add_argument("--json", action="store_true")

    pr = sub.add_parser("run")
    pr.add_argument("--now")
    pr.add_argument("--dry-run", action="store_true")
    pr.add_argument("--backend")
    pr.add_argument("--wake", action="store_true")

    pv = sub.add_parser("improve")
    pv.add_argument("--id")
    pv.add_argument("--dry-run", action="store_true")

    for name in ("logs", "log"):
        pg = sub.add_parser(name)
        pg.add_argument("id", nargs="?")
        pg.add_argument("-f", "--follow", action="store_true")
        pg.add_argument("-n", "--lines", type=int)
        pg.add_argument("--runner", action="store_true")

    for verb in ("enable", "disable"):
        pe = sub.add_parser(verb)
        pe.add_argument("id", nargs="?")
        pe.add_argument("--scheduler", action="store_true")

    for name in ("remove", "rm"):
        prm = sub.add_parser(name)
        prm.add_argument("id", nargs="?")
        prm.add_argument("--purge", action="store_true")
        prm.add_argument("-y", "--yes", action="store_true")

    sub.add_parser("doctor")
    sub.add_parser("scheduler").add_argument("action", nargs="?", default="status")
    sub.add_parser("skills").add_argument("action", nargs="?", default="status")
    sub.add_parser("uninstall").add_argument("--purge", action="store_true")
    sub.add_parser("version")
    return p


DISPATCH = {
    "init": cmd_init, "add": cmd_add, "list": cmd_list, "ls": cmd_list,
    "status": cmd_status, "st": cmd_status, "run": cmd_run, "improve": cmd_improve,
    "logs": cmd_logs,
    "log": cmd_logs, "enable": cmd_enable, "disable": cmd_disable,
    "remove": cmd_remove, "rm": cmd_remove, "doctor": cmd_doctor,
    "scheduler": cmd_scheduler, "skills": cmd_skills, "uninstall": cmd_uninstall,
    "version": cmd_version,
}


def main(argv):
    if argv and argv[0] in ("-V", "--version"):
        print("claudecron %s" % read_version())
        return 0
    parser = build_parser()
    args = parser.parse_args(argv)
    if not args.command:
        parser.print_usage(sys.stderr)
        return 2
    paths = Paths(args.config_dir)
    config = Config(paths)
    registry = Registry(paths)
    state = State(paths)
    backend = Backend(config)
    runner = Runner(paths, config, registry, state, backend)
    self_bin = str(Path(__file__).resolve())
    ctx = {
        "paths": paths, "config": config, "registry": registry, "state": state,
        "backend": backend, "runner": runner, "json": args.json,
        "scheduler": lambda: Scheduler(paths, self_bin),
        "skills": lambda: Skills(libexec_root()),
    }
    handler = DISPATCH.get(args.command)
    if handler is None:
        parser.print_usage(sys.stderr)
        return 2
    rc = handler(args, ctx)
    return rc if isinstance(rc, int) else 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
